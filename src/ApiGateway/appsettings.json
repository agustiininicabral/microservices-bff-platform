{
  "Jwt":{"Issuer":"microservices-bff-platform"},
  "ReverseProxy":{
    "Routes":{
      "identity":{"ClusterId":"identity","Match":{"Path":"/api/auth/{**catch-all}"}},
      "catalog":{"ClusterId":"catalog","AuthorizationPolicy":"default","Match":{"Path":"/api/catalog/{**catch-all}"}},
      "orders":{"ClusterId":"orders","AuthorizationPolicy":"default","Match":{"Path":"/api/orders/{**catch-all}"}},
      "web-bff":{"ClusterId":"web-bff","AuthorizationPolicy":"default","Match":{"Path":"/api/web/{**catch-all}"}}
    },
    "Clusters":{
      "identity":{"Destinations":{"identity":{"Address":"http://localhost:5100/"}}},
      "catalog":{"Destinations":{"catalog":{"Address":"http://localhost:5101/"}}},
      "orders":{"Destinations":{"orders":{"Address":"http://localhost:5102/"}}},
      "web-bff":{"Destinations":{"web-bff":{"Address":"http://localhost:5103/"}}}
    }
  }
}
